    {
      "id": "keeper_letters",
      "at": "loc:keeper_desk",
      "radius": 1.4,
      "when": {
        "flag": "keeper_door_open"
      },
      "variants": [
        {
          "id": "one",
          "when": {
            "not": {
              "flag": "letter_1"
