          "prompt": "读第一封信",
          "sets": [
            "letter_1"
          ],
          "note": {
            "title": "第一封",
            "lines": [
              "今天也没有船来。",
              "可灯还是要点的。万一有一艘迷了路呢。"
            ]
          }
        },
        {
          "id": "two",
          "when": {
            "not": {
              "flag": "letter_2"
            }
